FROM {{ upstream.image }}:{{ upstream.tag }}@{{ upstream.digest }}

ARG RUNNER_VERSION={{ params.runner_version }}
ARG TARGETARCH
ARG BUILD_DATE
ARG REVISION
ARG VERSION

LABEL org.opencontainers.image.title="Organization GitHub Actions Runner" \
  org.opencontainers.image.description="GitHub Actions self-hosted runner on Ubuntu ${VERSION}" \
  org.opencontainers.image.version="${VERSION}" \
  org.opencontainers.image.created="${BUILD_DATE}" \
  org.opencontainers.image.revision="${REVISION}" \
  org.opencontainers.image.source="https://github.com/nickkostov/docker"

ENV DEBIAN_FRONTEND=noninteractive

USER root

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    gzip \
    jq \
    sudo \
    tar \
    unzip \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid {{ user.gid }} {{ user.name }} \
  && useradd --uid {{ user.uid }} --gid {{ user.gid }} --create-home --home-dir {{ user.workdir }} --shell {{ user.shell }} {{ user.name }} \
  && usermod -aG sudo {{ user.name }} \
  && echo '{{ user.name }} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/{{ user.name }} \
  && chmod 0440 /etc/sudoers.d/{{ user.name }}

WORKDIR {{ user.workdir }}

RUN case "${TARGETARCH}" in \
      amd64) runner_arch="x64" ;; \
      arm64) runner_arch="arm64" ;; \
      *) echo "Unsupported architecture: ${TARGETARCH}"; exit 1 ;; \
    esac \
  && curl -fsSL \
    "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-${runner_arch}-${RUNNER_VERSION}.tar.gz" \
    -o runner.tar.gz \
  && tar -xzf runner.tar.gz \
  && rm runner.tar.gz \
  && mv run.sh runner-entrypoint.sh \
  && ./bin/installdependencies.sh \
  && chown -R {{ user.uid }}:{{ user.gid }} {{ user.workdir }}

COPY --chown={{ user.uid }}:{{ user.gid }} run.sh {{ user.workdir }}/run.sh
RUN chmod +x {{ user.workdir }}/run.sh

USER {{ user.uid }}:{{ user.gid }}
ENTRYPOINT ["{{ user.workdir }}/run.sh"]
